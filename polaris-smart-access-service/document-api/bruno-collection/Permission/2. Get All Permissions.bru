meta {
  name: 2. Get All Permissions
  type: http
  seq: 2
}

post {
  url: {{local}}admin/permissions/getAll
  body: json
  auth: inherit
}

headers {
  user-username: {{username}}
  Content-Type: application/json
}

body:json {
  {
      "filters": {},
      "paging": {
          "page": 1,
          "pageSize": 25,
          "sortBy": "resource",
          "sortDirection": "asc"
      }
  }
}

script:post-response {
  var jsonData = res.getBody();
  test('Status 200', function() { expect(res.getStatus()).to.equal(200); });
  if (jsonData.data && jsonData.data.data && jsonData.data.data.length > 0) {
      bru.setVar('permission_id', jsonData.data.data[0].id);
  }
}

settings {
  encodeUrl: true
}
