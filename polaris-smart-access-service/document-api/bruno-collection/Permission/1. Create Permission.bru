meta {
  name: 1. Create Permission
  type: http
  seq: 1
}

post {
  url: {{local}}/admin/permissions/save
  body: json
  auth: inherit
}

headers {
  user-username: {{username}}
  Content-Type: application/json
}

body:json {
  {
      "key": "receipt:create",
      "resource": "receipt",
      "action": "create",
      "description": "Buat receipt baru",
      "module": "inbound"
  }
}

script:post-response {
  var jsonData = res.getBody();
  test('Status 200', function() { expect(res.getStatus()).to.equal(200); });
}

settings {
  encodeUrl: true
  timeout: 0
}
