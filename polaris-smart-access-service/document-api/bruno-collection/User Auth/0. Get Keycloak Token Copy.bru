meta {
  name: 0. Get Keycloak Token Copy
  type: http
  seq: 2
}

post {
  url: {{keycloak_url}}/realms/polaris/protocol/openid-connect/token
  body: formUrlEncoded
  auth: inherit
}

headers {
  Content-Type: application/x-www-form-urlencoded
}

body:form-urlencoded {
  grant_type: password
  client_id: {{client_id}}
  username: {{username}}
  password: {{password}}
  ~client_secret: {{client_secret}}
}

script:post-response {
  var jsonData = res.getBody();
  bru.setVar('access_token', jsonData.access_token);
}

settings {
  encodeUrl: true
}
